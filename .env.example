# Figma personal access token.
# Create at: Figma -> Settings -> Security -> Personal access tokens
# Scope needed: "File content" (read). Variables audit additionally needs
# "Variables" read scope AND an Enterprise plan - it degrades gracefully without it.
FIGMA_TOKEN=

# The Figma frame to compare against.
# Copy the link to the frame: right-click frame -> Copy/Paste as -> Copy link
# Looks like: https://www.figma.com/design/<fileKey>/<name>?node-id=1-234
FIGMA_FRAME_URL=

# The implemented page to audit.
PAGE_URL=

# Optional. Defaults to the Figma frame's own width (auto-derived, see doc 3.1).
# Only set this to deliberately override; a mismatch makes every finding noise.
VIEWPORT_WIDTH=

# Optional. Initial viewport height; the page is scrolled to full height regardless.
VIEWPORT_HEIGHT=900

# Optional - S5 prose report only. Findings, HTML and console work without it.
# LLM_PROVIDER=gemini | anthropic   (inferred from whichever key is set if omitted)
# LLM_MODEL=                        (defaults: gemini-3.5-flash / claude-opus-5)
LLM_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
